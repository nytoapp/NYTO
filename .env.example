# Local development only. Copy to .env. Never commit .env.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://atlas:atlas@localhost:5432/atlas
REDIS_URL=redis://127.0.0.1:6379
# Generate replacements before any shared environment. These values are dev-only.
AUTH_JWT_SECRET=dev-only-jwt-secret-change-before-any-deploy
AUTH_REFRESH_PEPPER=dev-only-refresh-pepper-change-me
AUTH_DESTINATION_SECRET=dev-only-destination-hmac-secret-change
# Logs one-time codes on the API process. Refused when NODE_ENV=production.
AUTH_LOG_DEV_OTP=true
# Refused when NODE_ENV=production.
FIXTURE_PROVIDER_ENABLED=true
CORS_ORIGINS=http://localhost:8081,http://localhost:5173
GOOGLE_CLIENT_IDS=
GOOGLE_PLACES_API_KEY=
APPLE_CLIENT_IDS=
# Mobile Google sign-in reads apps/mobile/.env, not this file.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID must be the Web OAuth client ID, and that same ID must be listed in GOOGLE_CLIENT_IDS.
# EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME is the reversed iOS client ID (com.googleusercontent.apps....) when google-services.json is not used.
# E.164 country calling codes allowed to receive OTP, comma-separated. Example: 1,33,91
PHONE_COUNTRY_ALLOWLIST=
SENTRY_DSN=
