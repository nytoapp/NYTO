{
  "expo": {
    "name": "CITYDAY",
    "slug": "atlas",
    "scheme": "atlas",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": ["expo-router", "expo-localization", "expo-secure-store"],
    "experiments": {
      "typedRoutes": false
    },
    "ios": {
      "bundleIdentifier": "com.atlas.discovery",
      "supportsTablet": true
    },
    "android": {
      "package": "com.atlas.discovery"
    }
  }
}
